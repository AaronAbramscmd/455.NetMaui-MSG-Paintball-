<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MSG_Paintball.ContactPage"
    Title="Contact Us"
    BackgroundColor="#0D0D0D"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="NavStyle" TargetType="Label">
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="118,*"
          BackgroundColor="#0D0D0D">

        <Grid Grid.Row="0" BackgroundColor="#0D0D0D">

            <ScrollView Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never">

                <HorizontalStackLayout
                    Spacing="38"
                    Padding="30,0"
                    VerticalOptions="Center">

                    <Label Text="Home" Style="{StaticResource NavStyle}" />
                    <Label Text="Hours/Locations" Style="{StaticResource NavStyle}" />
                    <Label Text="Paintball Field" Style="{StaticResource NavStyle}" />
                    <Label Text="Prices" Style="{StaticResource NavStyle}" />
                    <Label Text="Paintball Birthday Parties" Style="{StaticResource NavStyle}" />
                    <Label Text="Airsoft Birthday Parties" Style="{StaticResource NavStyle}" />
                    <Label Text="Gell Ball Parties" Style="{StaticResource NavStyle}" />
                    <Label Text="FAQ" Style="{StaticResource NavStyle}" />
                    <Label Text="Contact" Style="{StaticResource NavStyle}" />
                    <Label Text="Online Store" Style="{StaticResource NavStyle}" />

                </HorizontalStackLayout>
            </ScrollView>

            <BoxView HeightRequest="2"
                     Color="#CC0000"
                     VerticalOptions="End" />

        </Grid>
        <ScrollView Grid.Row="1">

            <VerticalStackLayout
                Spacing="0"
                Padding="15,27,15,40"
                HorizontalOptions="Fill">

                <Label
             Text="Contact Us"
             FontSize="45"
            FontAttributes="Bold"
            TextColor="#FFFFFF"
            HorizontalTextAlignment="Center"
            HorizontalOptions="Fill"
            IsVisible="True" />

                <Label
                    Text="Have a question? Get in touch!"
                    FontSize="22"
                    FontAttributes="Bold"
                    TextColor="White"
                    HorizontalTextAlignment="Center"
                    Margin="0,28,0,0" />

                  <Border
                    MaximumWidthRequest="404"
                    HorizontalOptions="Center"
                    BackgroundColor="#F2F2F2"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 9"
                    Padding="35"
                    Margin="0,69,0,0">

                    <VerticalStackLayout Spacing="0">

                        <Label Text="Enter Name:"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#222222" />

                        <Entry x:Name="NameEntry"
                               Placeholder="Enter your name"
                               BackgroundColor="White"
                               TextColor="#222222"
                               PlaceholderColor="#999999"
                               HeightRequest="46"
                               FontSize="16"
                               Margin="0,4,0,16" />

                        <Label Text="Email:"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#222222" />

                        <Entry x:Name="EmailEntry"
                               Placeholder="Enter email address"
                               Keyboard="Email"
                               BackgroundColor="White"
                               TextColor="#222222"
                               PlaceholderColor="#999999"
                               HeightRequest="46"
                               FontSize="16"
                               Margin="0,4,0,16" />

                        <Label Text="Subject:"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#222222" />

                        <Entry x:Name="SubjectEntry"
                               Placeholder="Enter text here"
                               BackgroundColor="White"
                               TextColor="#222222"
                               PlaceholderColor="#999999"
                               HeightRequest="46"
                               FontSize="16"
                               Margin="0,4,0,16" />

                        <Label Text="Notes:"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#222222" />

                        <Editor x:Name="NotesEditor"
                                Placeholder="Anything you would like to say?"
                                BackgroundColor="White"
                                TextColor="#222222"
                                PlaceholderColor="#999999"
                                HeightRequest="44"
                                FontSize="14"
                                Margin="0,4,0,25" />

                        <Button
                            Text="Submit"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="White"
                            BackgroundColor="#CC0000"
                            CornerRadius="5"
                            HeightRequest="50"
                            Clicked="OnSubmitClicked" />

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>
