<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="msg_MAUI2.MainPage"
             BackgroundColor="#0d0d0d">

    <StackLayout Padding="30" Spacing="20" VerticalOptions="Center">
        
        <Label Text="MSG Paintball Dashboard" 
               TextColor="White" 
               FontSize="30" 
               FontAttributes="Bold" 
               HorizontalOptions="Center"/>
        
        <Label Text="Welcome back to the app!" 
               TextColor="#cccccc" 
               HorizontalOptions="Center"
               Margin="0,0,0,20"/>

        <Button Text="View Hours and Locations" 
                Clicked="OnHoursClicked" 
                BackgroundColor="#d00000" 
                TextColor="White" 
                FontAttributes="Bold"
                CornerRadius="5"
                HeightRequest="50"/>

        <Button Text="Log Out" 
                Clicked="OnLogoutClicked" 
                BackgroundColor="#333333" 
                TextColor="White" 
                FontAttributes="Bold"
                CornerRadius="5"
                HeightRequest="50"/>
        
    </StackLayout>
</ContentPage>
